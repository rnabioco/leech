# uv - multi-cluster support
if [[ "$HOSTNAME" == *alpine* ]]; then
    # Alpine cluster
    SCRATCH_BASE="/scratch/alpine/$USER"
else
    # Default (e.g., beevol-based systems)
    SCRATCH_BASE="/beevol/home/$USER"
fi

export UV_CACHE_DIR="$SCRATCH_BASE/.cache/uv"
export UV_PROJECT_ENVIRONMENT="$SCRATCH_BASE/leech/.venv"

source "$UV_PROJECT_ENVIRONMENT/bin/activate"
